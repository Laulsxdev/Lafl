# Supabase project keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dashboard -> Project Settings -> API keys -> service_role (KEEP SECRET)
SUPABASE_SERVICE_ROLE_KEY=

# Integration credentials (MarketPe key/GSTIN, GPS webhook tokens) are PER-ORG
# and live in the org_integrations table — managed via the super admin panel.

# Cron route auth (pg_cron -> /api/cron/*)
CRON_SECRET=generate-with-openssl-rand-hex-24
